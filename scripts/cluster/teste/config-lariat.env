# Configuração de TESTE: as mesmas políticas do projeto, apontadas para uma imagem pública
# de terceiros que já tem tudo o que o nosso pipeline vai produzir (assinatura keyless de
# um workflow do GitHub Actions, SBOM CycloneDX, atestado vuln do Trivy e proveniência
# SLSA v0.2 do slsa-github-generator), no formato legado do cosign 2.x (.sig/.att).
#
#   imagem:      ghcr.io/chipzoller/lariat (projeto de um mantenedor do Kyverno)
#   0.0.37:      sha256:31832bbb8d887342115cbe1d4ad2ee03d289ae6b9970e362e8982384c330266a
#   0.0.4:       sha256:914420dfcfe38e95f85a98d56516ddc7b7aced7138578601c34419c4fc81e340 (sem assinatura)
#   identidades conferidas com `cosign verify` / `cosign verify-attestation` em 21/11/2026.
#
# Uso: CONFIG=scripts/cluster/teste/config-lariat.env scripts/cluster/aplicar-politicas.sh --imprimir
OWNER=chipzoller
REPO=lariat
IMAGEM="ghcr.io/chipzoller/lariat"
EMISSOR_OIDC="https://token.actions.githubusercontent.com"
# O lariat assina a partir de tags (refs/tags/<versão>), então a identidade muda a cada
# versão; o curinga imita o nosso caso (mesma identidade para todas as versões da main).
IDENTIDADE_PIPELINE="${IDENTIDADE_PIPELINE:-https://github.com/chipzoller/lariat/.github/workflows/release.yaml@refs/tags/*}"
IDENTIDADE_REESCANEAR="https://github.com/chipzoller/lariat/.github/workflows/reescanear.yml@refs/heads/main"
IDENTIDADE_ATAQUES="https://github.com/chipzoller/lariat/.github/workflows/ataques.yml@refs/heads/main"
VERSAO_SLSA_GENERATOR="v2.0.0"
IDENTIDADE_PROVENIENCIA="https://github.com/slsa-framework/slsa-github-generator/.github/workflows/generator_container_slsa3.yml@refs/tags/${VERSAO_SLSA_GENERATOR}"
URI_FONTE_ESPERADA="${URI_FONTE_ESPERADA:-git+https://github.com/chipzoller/lariat@refs/tags/0.0.37}"
ENTRYPOINT_ESPERADO=".github/workflows/release.yaml"
REKOR_URL="https://rekor.sigstore.dev"
JANELA_VARREDURA="${JANELA_VARREDURA:-24h}"
CLUSTER="${CLUSTER:-teste-politicas}"
NAMESPACE="loja"
