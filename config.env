# Configuração única do projeto. Os scripts fazem `source config.env` (bash).
# Para rodar em outra conta do GitHub, troque só OWNER (e REPO, se mudar o nome).

OWNER=LeoLuizGO
REPO=sigstore-supply-chain

# Nome da imagem no GHCR (o GHCR exige minúsculas)
OWNER_MINUSCULO=$(printf '%s' "$OWNER" | tr '[:upper:]' '[:lower:]')
IMAGEM="ghcr.io/${OWNER_MINUSCULO}/${REPO}"

# Identidades aceitas (SAN do certificado Fulcio) e emissor OIDC
EMISSOR_OIDC="https://token.actions.githubusercontent.com"
IDENTIDADE_PIPELINE="https://github.com/${OWNER}/${REPO}/.github/workflows/pipeline.yml@refs/heads/main"
IDENTIDADE_REESCANEAR="https://github.com/${OWNER}/${REPO}/.github/workflows/reescanear.yml@refs/heads/main"
IDENTIDADE_ATAQUES="https://github.com/${OWNER}/${REPO}/.github/workflows/ataques.yml@refs/heads/main"
VERSAO_SLSA_GENERATOR="v2.1.0"
IDENTIDADE_PROVENIENCIA="https://github.com/slsa-framework/slsa-github-generator/.github/workflows/generator_container_slsa3.yml@refs/tags/${VERSAO_SLSA_GENERATOR}"

REKOR_URL="https://rekor.sigstore.dev"

# Janela de validade do atestado de varredura de vulnerabilidades (cenário de rollback)
JANELA_VARREDURA="24h"

# Cluster local
CLUSTER="sigstore"
NAMESPACE="loja"
